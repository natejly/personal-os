{
  "id": "memory-tree",
  "name": "History digest",
  "description": "A bounded digest of everything you have told me: recent memories verbatim, older ones summarised by age, with zoom",
  "version": "1.0.0",
  "apiVersion": 1,
  "kind": "extension",
  "enabled": false,
  "activation": ["startup"],
  "requires": { "services": ["memories"] },
  "contributes": {
    "tools": [
      { "name": "memory_zoom", "danger": "safe", "group": "memory-tree" },
      { "name": "memory_tree_status", "danger": "safe", "group": "memory-tree" }
    ],
    "routes": { "prefix": "/memory-tree" },
    "runtime": [{ "slot": "memory.system", "id": "digest", "label": "History digest" }]
  },
  "hooks": { "memory.written": {}, "memory.deleted": {}, "turn.settled": {} },
  "permissions": ["db:own", "service:memories", "runtime:memory"],
  "settings": {
    "memoryTreeDigestTokens": { "type": "integer", "default": 1500, "minimum": 300, "maximum": 6000 },
    "memoryTreeMergesPerTurn": { "type": "integer", "default": 2, "minimum": 0, "maximum": 10 },
    "memoryTreeMergeModel": { "type": "string", "default": "fast", "enum": ["fast", "default"] },
    "memoryTreeIncludeAuto": { "type": "boolean", "default": true }
  },
  "data": {
    "tables": ["memory_tree_leaf", "memory_tree_node"],
    "migrations": "migrations/"
  }
}
