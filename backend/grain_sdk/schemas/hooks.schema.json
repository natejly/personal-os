{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Hooks",
  "description": "Payload of every hook (design doc section 5). kind is how the host calls the handlers: emit and collect take the payload, pipe and gate take the current value.",
  "x-hooks": {
    "app.start": {"kind": "emit", "description": "The app is up and the extension is loaded. Start loops here, with api.spawn.", "payload": {"type": "object", "properties": {}}},
    "app.stop": {"kind": "emit", "description": "The app is shutting down; the extension then stops."},
    "settings.changed": {"kind": "emit", "description": "Settings were written. Secret keys are listed without values.", "payload": {"type": "object", "properties": {"keys": {"type": "array", "items": {"type": "string"}}, "old": {"type": "object"}, "new": {"type": "object"}}, "required": ["keys", "old", "new"]}},
    "chat.created": {"kind": "emit", "description": "A conversation was created.", "payload": {"type": "object", "properties": {"id": {"type": "string"}, "project_id": {"anyOf": [{"type": "string"}, {"type": "null"}]}}, "required": ["id", "project_id"]}},
    "chat.deleted": {"kind": "emit", "description": "A conversation was deleted.", "payload": {"type": "object", "properties": {"id": {"type": "string"}, "project_id": {"anyOf": [{"type": "string"}, {"type": "null"}]}}, "required": ["id", "project_id"]}},
    "project.created": {"kind": "emit", "description": "A project was created.", "payload": {"type": "object", "properties": {"id": {"type": "string"}}, "required": ["id"]}},
    "project.deleted": {"kind": "emit", "description": "A project was deleted.", "payload": {"type": "object", "properties": {"id": {"type": "string"}}, "required": ["id"]}},
    "ext.changed": {"kind": "emit", "description": "An extension was enabled or disabled.", "payload": {"type": "object", "properties": {"id": {"type": "string"}, "enabled": {"type": "boolean"}}, "required": ["id", "enabled"]}},
    "turn.accept": {"kind": "pipe", "description": "A user message is about to start a turn.", "payload": {"type": "object", "properties": {"conversation_id": {"type": "string"}, "origin": {"type": "string"}, "content": {"type": "string"}, "attachments": {"type": "array", "items": {"type": "object"}}}, "required": ["conversation_id", "origin", "content", "attachments"]}},
    "turn.start": {"kind": "emit", "description": "The user message is stored and the turn begins.", "payload": {"type": "object", "properties": {"conversation_id": {"type": "string"}, "message_id": {"type": "string"}, "origin": {"type": "string"}}, "required": ["conversation_id", "message_id", "origin"]}},
    "input.attachment": {"kind": "pipe", "description": "An attachment is being read into text.", "payload": {"type": "object", "properties": {"file": {"type": "object"}}, "required": ["file"]}},
    "context.contribute": {"kind": "collect", "description": "Add text to the prompt; a handler returns a Contribution.", "payload": {"type": "object", "properties": {"conversation_id": {"type": "string"}, "project_id": {"anyOf": [{"type": "string"}, {"type": "null"}]}}, "required": ["conversation_id", "project_id"]}},
    "model.select": {"kind": "pipe", "description": "The turn's model is chosen; return {model, effort} to change it.", "payload": {"type": "object", "properties": {"model": {"type": "string"}, "effort": {"type": "string"}, "reason": {"type": "string"}, "tier": {"enum": ["fast", "default"]}}, "required": ["model", "effort", "reason", "tier"]}},
    "model.request": {"kind": "emit", "description": "A model call is about to be sent.", "payload": {"type": "object", "properties": {"model": {"type": "string"}, "message_count": {"type": "integer"}, "tool_names": {"type": "array", "items": {"type": "string"}}, "tokens_est": {"type": "integer"}}, "required": ["model", "message_count", "tool_names", "tokens_est"]}},
    "model.response": {"kind": "emit", "description": "A model call recorded its usage.", "payload": {"type": "object", "properties": {"model": {"type": "string"}, "kind": {"type": "string"}, "duration_ms": {"type": "integer"}, "estimated": {"type": "boolean"}, "prompt_tokens": {"type": "integer"}, "completion_tokens": {"type": "integer"}, "cached_tokens": {"type": "integer"}, "cache_write_tokens": {"type": "integer"}, "reasoning_tokens": {"type": "integer"}, "conversation_id": {"type": "string"}, "project_id": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "tag": {"type": "string"}, "round": {"type": "integer"}}, "required": ["model", "kind", "duration_ms", "estimated", "prompt_tokens", "completion_tokens", "cached_tokens", "cache_write_tokens", "reasoning_tokens"]}},
    "tools.offer": {"kind": "pipe", "description": "The tool names offered to the model; a handler may hide some.", "payload": {"type": "object", "properties": {"names": {"type": "array", "items": {"type": "string"}}}, "required": ["names"]}},
    "tool.permission": {"kind": "gate", "description": "A call is being checked against the permission stack; Deny or Ask only.", "payload": {"type": "object", "properties": {"name": {"type": "string"}, "args": {"type": "object"}, "danger": {"type": "string"}, "mode": {"type": "string"}, "tainted": {"type": "boolean"}}, "required": ["name", "args", "danger", "mode", "tainted"]}},
    "tool.pre": {"kind": "gate", "description": "A tool call is about to run; Deny or Ask only.", "payload": {"type": "object", "properties": {"name": {"type": "string"}, "args": {"type": "object"}, "call_id": {"type": "string"}, "ctx": {"type": "object", "properties": {"run_id": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "conversation_id": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "project_id": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "agent_id": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "tainted": {"type": "boolean"}, "desk_id": {"anyOf": [{"type": "string"}, {"type": "null"}]}}, "required": ["run_id", "conversation_id", "project_id", "agent_id", "tainted", "desk_id"]}}, "required": ["name", "args", "call_id", "ctx"]}},
    "tool.post": {"kind": "emit", "description": "A tool call finished.", "payload": {"type": "object", "properties": {"name": {"type": "string"}, "call_id": {"type": "string"}, "args": {"type": "object"}, "result_preview": {"type": "string"}, "error": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "duration_ms": {"type": "integer"}}, "required": ["name", "call_id", "args", "result_preview", "error", "duration_ms"]}},
    "tool.result": {"kind": "pipe", "description": "A tool's whole result before it is rendered for the model; return the payload with result changed.", "payload": {"type": "object", "properties": {"name": {"type": "string"}, "call_id": {"type": "string"}, "result": {}, "tainted": {"type": "boolean"}}, "required": ["name", "call_id", "result", "tainted"]}},
    "tool.taint": {"kind": "emit", "description": "A call added a taint source to the run.", "payload": {"type": "object", "properties": {"name": {"type": "string"}, "source": {"type": "string"}}, "required": ["name", "source"]}},
    "tool.error": {"kind": "emit", "description": "A tool call failed.", "payload": {"type": "object", "properties": {"name": {"type": "string"}, "call_id": {"type": "string"}, "error": {"type": "string"}}, "required": ["name", "call_id", "error"]}},
    "reply.complete": {"kind": "emit", "description": "The reply is complete (credentials scrubbed).", "payload": {"type": "object", "properties": {"message_id": {"type": "string"}, "text": {"type": "string"}, "tool_events": {"type": "array", "items": {"type": "object"}}, "usage": {"type": "object", "properties": {"tokens": {"type": "integer"}, "cost": {"type": "number"}, "rounds": {"type": "integer"}}, "required": ["tokens", "cost", "rounds"]}, "trace": {"type": "array", "items": {"type": "object"}}, "taint": {"type": "object", "properties": {"tainted": {"type": "boolean"}, "sources": {"type": "array", "items": {"type": "string"}}}, "required": ["tainted", "sources"]}, "outcome": {"anyOf": [{"type": "string"}, {"type": "null"}]}}, "required": ["message_id", "text", "tool_events", "usage", "trace", "taint", "outcome"]}},
    "turn.settled": {"kind": "emit", "description": "The turn is over and the built-in learners ran (a scrubbed copy without the live trace).", "payload": {"type": "object", "properties": {"conversation_id": {"type": "string"}, "message_id": {"type": "string"}, "user_message_id": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "conv": {"type": "object"}, "cfg": {"type": "object"}, "model": {"type": "string"}, "user_text": {"type": "string"}, "run_user_texts": {"type": "array", "items": {"type": "string"}}, "reply": {"type": "string"}, "error": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "stopped": {"type": "boolean"}, "gone": {"type": "boolean"}, "internal": {"type": "boolean"}, "in_side": {"type": "boolean"}, "proposal_only": {"type": "boolean"}, "desk_id": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "tainted": {"type": "boolean"}, "tool_events": {"type": "array", "items": {"type": "object"}}, "used": {"type": "object"}, "placeholder_title": {"anyOf": [{"type": "string"}, {"type": "null"}]}}, "required": ["conversation_id", "message_id", "user_message_id", "conv", "cfg", "model", "user_text", "run_user_texts", "reply", "error", "stopped", "gone", "internal", "in_side", "proposal_only", "desk_id", "tainted", "tool_events", "used", "placeholder_title"]}},
    "run.after": {"kind": "emit", "description": "A run is about to be closed.", "payload": {"type": "object", "properties": {"run_id": {"type": "string"}}, "required": ["run_id"], "description": "The live Run object; run_id is the stable part."}},
    "subagent.start": {"kind": "emit", "description": "A subagent began running.", "payload": {"type": "object", "properties": {"child_id": {"type": "string"}, "role": {"type": "string"}, "parent": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "exit_reason": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "error": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "detached": {"type": "boolean"}}, "required": ["child_id", "role", "parent", "exit_reason", "error", "detached"]}},
    "subagent.stop": {"kind": "emit", "description": "A subagent finished.", "payload": {"type": "object", "properties": {"child_id": {"type": "string"}, "role": {"type": "string"}, "parent": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "exit_reason": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "error": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "detached": {"type": "boolean"}}, "required": ["child_id", "role", "parent", "exit_reason", "error", "detached"]}},
    "worker.report": {"kind": "collect", "description": "A worker's report is being handed back.", "payload": {"type": "object", "properties": {"worker": {"type": "string"}, "summary": {"type": "string"}}, "required": ["worker", "summary"]}},
    "memory.before_write": {"kind": "pipe", "description": "A memory is about to be written; return it changed, or Deny.", "payload": {"type": "object", "properties": {"content": {"type": "string"}, "kind": {"type": "string"}, "source": {"type": "string"}, "project_id": {"anyOf": [{"type": "string"}, {"type": "null"}]}}, "required": ["content", "kind", "source", "project_id"]}},
    "memory.written": {"kind": "emit", "description": "A memory was written.", "payload": {"type": "object", "properties": {"memory": {"type": "object"}, "source": {"type": "string"}}, "required": ["memory", "source"]}},
    "memory.deleted": {"kind": "emit", "description": "A memory was deleted or invalidated.", "payload": {"type": "object", "properties": {"memory": {"type": "object"}, "source": {"type": "string"}}, "required": ["memory", "source"]}},
    "compaction.before": {"kind": "pipe", "description": "History is about to be summarized; set summary to replace the built-in summarizer.", "payload": {"type": "object", "properties": {"messages": {"type": "array", "items": {"type": "object", "properties": {"role": {"type": "string"}, "content": {"type": "string"}}, "required": ["role", "content"]}}, "window": {"type": "integer"}, "summary": {"anyOf": [{"type": "string"}, {"type": "null"}]}}, "required": ["messages", "window", "summary"]}},
    "compaction.after": {"kind": "emit", "description": "A summary was saved.", "payload": {"type": "object", "properties": {"summary": {"type": "string"}}, "required": ["summary"]}},
    "approval.requested": {"kind": "emit", "description": "An approval card was opened.", "payload": {"type": "object", "properties": {"call_id": {"type": "string"}, "tool": {"type": "string"}, "args_digest": {"type": "string"}, "run_id": {"type": "string"}}, "required": ["call_id", "tool", "args_digest", "run_id"]}},
    "approval.resolved": {"kind": "emit", "description": "An approval was decided.", "payload": {"type": "object", "properties": {"call_id": {"type": "string"}, "decision": {"type": "string"}, "by": {"type": "string"}}, "required": ["call_id", "decision", "by"]}},
    "preset.applied": {"kind": "emit", "description": "A permission preset was applied at a scope. Key names only, never values.", "payload": {"type": "object", "properties": {"preset_id": {"type": "string"}, "scope": {"type": "string"}, "scope_id": {"type": "string"}, "changed_keys": {"type": "array", "items": {"type": "string"}}, "loosened": {"type": "array", "items": {"type": "string"}}, "by": {"type": "string"}}, "required": ["preset_id", "scope", "scope_id", "changed_keys", "loosened", "by"]}},
    "job.fired": {"kind": "emit", "description": "A scheduled job started.", "payload": {"type": "object", "properties": {"job_id": {"type": "string"}, "kind": {"type": "string"}, "trigger": {"type": "string"}}, "required": ["job_id", "kind", "trigger"]}},
    "job.done": {"kind": "emit", "description": "A scheduled job's run ended.", "payload": {"type": "object", "properties": {"job_id": {"type": "string"}, "run_id": {"type": "string"}, "outcome": {"anyOf": [{"type": "string"}, {"type": "null"}]}}, "required": ["job_id", "run_id", "outcome"]}},
    "schedule.tick": {"kind": "emit", "description": "An extension's interval job is due.", "payload": {"type": "object", "properties": {"name": {"type": "string"}}, "required": ["name"]}},
    "channel.inbound": {"kind": "emit", "description": "A message arrived on a channel.", "payload": {"type": "object", "properties": {"channel": {"type": "string"}, "sender": {"type": "string"}, "text": {"type": "string"}, "files": {"type": "array", "items": {"type": "object"}}}, "required": ["channel", "sender", "text", "files"]}},
    "channel.outbound": {"kind": "pipe", "description": "A reply is about to be sent on a channel.", "payload": {"type": "object", "properties": {"channel": {"type": "string"}, "text": {"type": "string"}, "files": {"type": "array", "items": {"type": "object"}}}, "required": ["channel", "text", "files"]}},
    "file.written": {"kind": "emit", "description": "A file was saved.", "payload": {"type": "object", "properties": {"path": {"type": "string"}, "owner": {"type": "string"}, "kind": {"type": "string"}}, "required": ["path", "owner", "kind"]}},
    "review.accepted": {"kind": "emit", "description": "A reviewed change was accepted.", "payload": {"type": "object", "properties": {"kind": {"type": "string"}, "id": {"type": "string"}}, "required": ["kind", "id"]}},
    "notify": {"kind": "emit", "description": "An extension asked for a notification.", "payload": {"type": "object", "properties": {"title": {"type": "string"}, "body": {"type": "string"}, "target": {}}, "required": ["title", "body", "target"]}},
    "coding.tool.pre": {"kind": "gate", "description": "A Claude Code session Grain started is about to run a tool; Deny or Ask only (the stricter of this and Grain's own floor wins).", "payload": {"type": "object", "properties": {"session_id": {"type": "string"}, "agent": {"type": "string"}, "tool": {"type": "string"}, "input": {"type": "object"}, "cwd": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "worktree": {"type": "string"}, "permission_mode": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "lifted": {"type": "boolean"}, "call_id": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "conversation_id": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "run_id": {"anyOf": [{"type": "string"}, {"type": "null"}]}}, "required": ["session_id", "agent", "tool", "input", "cwd", "worktree", "permission_mode", "lifted", "call_id", "conversation_id", "run_id"]}},
    "coding.tool.post": {"kind": "emit", "description": "A Claude Code session Grain started finished a tool call.", "payload": {"type": "object", "properties": {"session_id": {"type": "string"}, "agent": {"type": "string"}, "tool": {"type": "string"}, "input": {"type": "object"}, "cwd": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "worktree": {"type": "string"}, "permission_mode": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "lifted": {"type": "boolean"}, "call_id": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "conversation_id": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "run_id": {"anyOf": [{"type": "string"}, {"type": "null"}]}, "result_preview": {"type": "string"}, "duration_ms": {"anyOf": [{"type": "integer"}, {"type": "null"}]}}, "required": ["session_id", "agent", "tool", "input", "cwd", "worktree", "permission_mode", "lifted", "call_id", "conversation_id", "run_id", "result_preview", "duration_ms"]}}
  }
}
