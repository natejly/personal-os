# ---- Grain environment ----
# (Env var names keep the PERSONAL_OS_ prefix so existing .env files keep working.)
# Copy to .env and fill in. `.env` is git-ignored.

# Fireworks AI key (https://fireworks.ai/account/api-keys)
FIREWORKS_API_KEY=fw_xxxxxxxxxxxxxxxxxxxxxxxx

# Key that the app uses to talk to the LiteLLM proxy (any string; LiteLLM enforces it)
LITELLM_MASTER_KEY=sk-personal-os

# Where the LiteLLM proxy listens
LITELLM_PORT=4000

# Defaults seeded into the app's settings on first launch (change later in Settings ⌘,)
PERSONAL_OS_BASE_URL=http://localhost:4000
PERSONAL_OS_API_KEY=${LITELLM_MASTER_KEY}
PERSONAL_OS_DEFAULT_MODEL=kimi-k3
PERSONAL_OS_EXTRACTION_MODEL=deepseek-v4-flash

# Google Workspace (Calendar, Gmail, Tasks, Drive, Docs, Sheets). One "Desktop app" OAuth client
# for the whole install; users then just click "Sign in with Google" in Settings → Integrations.
# Create it at https://console.cloud.google.com/apis/credentials (enable the Calendar, Gmail,
# Tasks, Drive, Docs and Sheets APIs, configure the consent screen, application type "Desktop
# app" — a "Web application" client cannot accept the app's loopback callback). Restart the app
# after filling these in. Left empty, Settings → Integrations walks you through pasting one.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Microsoft 365 / Outlook (Mail + Calendar). A public-client Entra app registration: no secret, just the
# application (client) id. MICROSOFT_TENANT is `common` (work + personal), `organizations`, `consumers` or a tenant id.
# Setup steps: docs/microsoft.md
MICROSOFT_CLIENT_ID=
MICROSOFT_TENANT=

# --- Alternative: skip LiteLLM and hit Fireworks' OpenAI-compatible API directly ---
# PERSONAL_OS_BASE_URL=https://api.fireworks.ai/inference
# PERSONAL_OS_API_KEY=${FIREWORKS_API_KEY}
# PERSONAL_OS_DEFAULT_MODEL=accounts/fireworks/models/kimi-k3
